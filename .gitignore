# reconciliation-investigator — .gitignore (Ares V2 python-strands profile)
#
# *.log keeps agent-memory/guard-audit.log runtime-only (the project
# convention; aresV2 itself tracks its own log deliberately — projects
# do not).

*.log

# environment / secrets
.env
.env.*
!.env.example

# Claude Code local state
.claude/settings.local.json

# OS noise
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Eval report artifact — regenerated by every verify.sh step-6 run
# (experiment.to_file output); capture a copy into agent-memory/evidence/
# when a run's numbers matter, do not commit the working copy.
*_evaluation.json
